# (C) Copyright 2005- ECMWF.

# WMO Lead Centre for Global Climate Re-Analyses (LC-GCR)
if (!defined(class)) {
  constant marsClass = 'lr';
}

alias mars.class  = marsClass;
alias mars.stream = marsStream;
alias mars.type   = marsType;
alias mars.param = paramId;
alias mars.expver = marsExpver;
alias mars.origin = centre;

if (section2Used == 1) {
    alias mars.model = lcgcrSuiteID;
    unalias mars.domain;
#   unalias mars.model;
}

alias parameter=paramId;
alias parameter.paramId=paramId;
alias parameter.shortName=shortName;
alias parameter.units=units;
alias parameter.name=name;

unalias mars.domain;

# https://jira.ecmwf.int/browse/DGOV-513
#   https://confluence.ecmwf.int/spaces/DGOV/pages/514772203/Support+page+for+DGOV-513+LC-GCR
concept marsType(unknown) {
   fc = {
     typeOfProcessedData = 1;
   }
   "9" = {
     typeOfProcessedData = 1;
   }

   an = {
     typeOfProcessedData = 0;
   }
   "2" = {
     typeOfProcessedData = 0;
   }
}

if (defined(lengthOfTimeRange) && defined(typeOfStatisticalProcessing)) {
  # get the values from the 1st most outer loop which matter for moda/dame
  meta outerLoopLengthOfTimeRange element(lengthOfTimeRange, 0);
  meta outerLoopTypeOfStatisticalProcessing element(typeOfStatisticalProcessing, 0);
  meta outerLoopTypeOfTimeIncrement element(typeOfTimeIncrement, 0);
}

concept marsStream(unknown) {
    oper = {
      productDefinitionTemplateNumber = 0;
    }
    oper = {
      productDefinitionTemplateNumber = 8;
    }
    sttd = {
      productDefinitionTemplateNumber = 8;
      outerLoopTypeOfTimeIncrement = 1;
    }
} : no_copy,read_only;

